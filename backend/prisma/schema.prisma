generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  MEMBER
  VISITOR
}

enum ContentEntityType {
  MAJOR
  SCHOLARSHIP
}

/// ADDED COURSE HERE
enum FileOwnerType {
  MAJOR
  SCHOLARSHIP
  COURSE 
}

enum FileType {
  SUMMARY
  PREVIOUS_EXAM
  SYLLABUS
  OTHER
}

enum FileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewAction {
  APPROVE
  REJECT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  APPROVE
  REJECT
}

enum AuditEntityType {
  MAJOR
  SCHOLARSHIP
  FILE
  SECTION
  FAQ
  COURSE // ADDED COURSE HERE
}

// ───────────────────────────── RBAC ──────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ───────────────────────────── Users ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]
  uploadedFiles File[]         @relation("UploadedBy")
  reviews       FileReview[]   @relation("ReviewedBy")
  auditLogs     AuditLog[]     @relation("AuditActor")
  notifications Notification[]

  assignedMajors       Major[]       @relation("MajorModerators")
  assignedScholarships Scholarship[] @relation("ScholarshipModerators")

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────── Domain: Colleges / Majors / Scholarships ─

model College {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  majors Major[]

  @@map("colleges")
}

model Major {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  degree    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id])

  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  moderators User[] @relation("MajorModerators")
  
  // ADDED COURSES RELATION HERE
  courses Course[]

  @@index([deletedAt])
  @@index([collegeId])
  @@map("majors")
}

// ═══════════════════════════════════════════════════════════════════
// ADDED NEW COURSE MODEL HERE
// ═══════════════════════════════════════════════════════════════════
model Course {
  id          String   @id @default(cuid())
  name        String   // English name
  nameAr      String   // Arabic name
  code        String   // e.g. CS201
  year        Int      // e.g. 2
  semester    String   // e.g. Fall, Spring
  credits     Int      // e.g. 3
  icon        String   @default("📘") // Emoji

  majorId String
  major   Major  @relation(fields: [majorId], references: [id], onDelete: Cascade)

  @@index([majorId])
  @@map("courses")
}
// ═══════════════════════════════════════════════════════════════════

model Scholarship {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  startDate DateTime
  endDate   DateTime
  deleteReason String?

  moderators User[] @relation("ScholarshipModerators")

  @@index([deletedAt])
  @@map("scholarships")
}

// ─────────────────── Polymorphic Content System ──────────────────

model Section {
  id         String            @id @default(cuid())
  entityType ContentEntityType
  entityId   String
  title      String
  content    String            @db.Text
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([entityType, entityId])
  @@index([entityType, entityId, sortOrder])
  @@index([deletedAt])
  @@map("sections")
}

model Faq {
  id         String            @id @default(cuid())
  entityType ContentEntityType
  entityId   String
  question   String
  answer     String            @db.Text
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("faqs")
}

// ───────────────────── Files & Review Workflow ───────────────────

model File {
  id           String     @id @default(cuid())
  title        String
  description  String?
  type         FileType
  status       FileStatus @default(PENDING)
  storageKey   String 
  mimeType     String?
  sizeBytes    Int?
  
  // ── ADDED NEW FIELDS FOR THE UI ──
  tags         String[]   // Array of tags
  rating       Float      @default(0) // Average rating (0 to 5)
  downloads    Int        @default(0) // Download counter
  // ─────────────────────────────────

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownerType    FileOwnerType
  ownerId      String

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  reviews FileReview[]

  @@index([uploadedById])
  @@index([status])
  @@index([type])
  @@index([ownerType, ownerId])
  @@index([ownerType, ownerId, type])
  @@index([deletedAt])
  @@map("files")
}

model FileReview {
  id        String       @id @default(cuid())
  fileId    String
  reviewerId String
  action    ReviewAction
  comment   String?
  createdAt DateTime     @default(now())

  file     File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewedBy", fields: [reviewerId], references: [id])

  @@index([fileId])
  @@index([reviewerId])
  @@map("file_reviews")
}

// ───────────────────────────── Contact ───────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isHandled])
  @@map("contact_messages")
}

// ───────────────────────────── Audit Log ─────────────────────────

model AuditLog {
  id         String          @id @default(cuid())
  userId     String
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  user User @relation("AuditActor", fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────── Notifications ───────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}