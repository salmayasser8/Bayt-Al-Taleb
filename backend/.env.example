# ────────────────────────────────────────────────────────────
#  Bayt Al Taleb — Environment Variables
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database (PostgreSQL / Neon) ──────────────────────────────
# DATABASE_URL = pooled connection string (used by the app at runtime)
# DIRECT_URL   = direct (non-pooled) connection string (used by Prisma Migrate)
#
# On Neon: copy BOTH connection strings from the dashboard. The pooled one
# contains "-pooler" in the host. For local Postgres, set both to the same URL.
#
# ⚠️ If you change DATABASE_URL for a new database, you MUST also update
#    DIRECT_URL, then run:  npx prisma migrate deploy   (BEFORE seeding)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bayt_al_taleb?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bayt_al_taleb?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-16-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-16-chars-long"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (REQUIRED — the server refuses to boot without these)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Security
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
